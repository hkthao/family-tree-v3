# Copy thành worker.env cạnh docker-compose.yml trên máy chủ xuất sổ, `chmod 600`.
# Supabase self-host (công khai qua HTTPS):
SUPABASE_URL=https://<supabase-host>
# BÍ MẬT QUYỀN CAO — bỏ qua RLS. Chỉ đặt trên máy chủ này.
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY trong file .env của Supabase self-host>
# Tên worker (hiện trong log và bảng export_workers). Bỏ trống thì dùng hostname.
WORKER_ID=book-worker-1
# Trần số người một sổ; vượt thì app tự lùi về xuất ngay trên trình duyệt. Đo lại trên máy thật rồi chỉnh.
MAX_PERSONS=400
