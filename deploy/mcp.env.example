# Copy thành /opt/gia-pha-mcp/mcp.env trên máy web, `chmod 600`.
# Supabase self-host (công khai qua HTTPS):
SUPABASE_URL=https://db.srv1128614.hstgr.cloud
SUPABASE_ANON_KEY=<ANON_KEY dạng JWT trong /root/supabase/.env trên máy DB>
# Hai khoá dưới đây là BÍ MẬT QUYỀN CAO — ai có JWT_SECRET đều ký được JWT của bất kỳ người dùng.
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY trong /root/supabase/.env>
JWT_SECRET=<JWT_SECRET trong /root/supabase/.env>
PORT=3333
