# Copy thành /opt/gia-pha-mcp/mcp.env trên máy web, `chmod 600`.
# Supabase self-host (công khai qua HTTPS):
SUPABASE_URL=https://<supabase-host>
SUPABASE_ANON_KEY=<ANON_KEY dạng JWT trong file .env của Supabase self-host>
# Hai khoá dưới đây là BÍ MẬT QUYỀN CAO — ai có JWT_SECRET đều ký được JWT của bất kỳ người dùng.
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY trong file .env của Supabase self-host>
JWT_SECRET=<JWT_SECRET trong file .env của Supabase self-host>
PORT=3333
