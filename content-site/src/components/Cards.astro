---
import type { Article } from "../lib";
import { shortName } from "../lib";
const { items } = Astro.props as { items: Article[] };
---
<div class="cards">
  {items.map((a) => (
    <a href={`/so-tay/${a.id}.html`}><b>{shortName(a)}</b><span>{a.data.when ?? a.data.timing ?? ""}{a.data.where ? ` · ${a.data.where}` : ""}{!a.data.when && !a.data.timing ? a.data.description.slice(0, 110) : ""}</span></a>
  ))}
</div>
