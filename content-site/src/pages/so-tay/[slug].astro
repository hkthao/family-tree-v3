---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import { published, shortName, isoDate } from "../../lib";
import { categoryName, categoryUrl, slugify } from "../../taxonomy";

export async function getStaticPaths() {
  const all = await published();
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
const g = entry.data;
const { Content } = await render(entry);
const SITE = "https://donghoviet.thaohk.com";
const path = `/so-tay/${entry.id}.html`;
const hero = g.images[0];
const iso = isoDate(entry);
const org = { "@type": "Organization", name: "Dòng Họ Việt", url: `${SITE}/`, logo: `${SITE}/assets/app-icon-180.png` };
const image = hero ? `/assets/le-hoi/${hero.file}` : g.cover_image_url;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Article", headline: g.title, description: g.description, inLanguage: "vi", datePublished: iso, dateModified: iso, mainEntityOfPage: `${SITE}${path}`, image: image ? (image.startsWith("http") ? image : `${SITE}${image}`) : `${SITE}/assets/og-banner.png`, keywords: g.tags.join(", "), author: org, publisher: org },
    { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Dòng Họ Việt", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Sổ tay văn hoá", item: `${SITE}/so-tay.html` },
      { "@type": "ListItem", position: 3, name: categoryName(g.category), item: `${SITE}/so-tay/danh-muc/${categoryUrl(g.category)}.html` },
      { "@type": "ListItem", position: 4, name: shortName(entry), item: `${SITE}${path}` } ] },
    ...(g.faq.length ? [{ "@type": "FAQPage", mainEntity: g.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) }] : []),
  ],
};
const related = g.related.map((s) => all.find((x) => x.id === s)).filter(Boolean);
const d = iso.split("-").reverse().join("/");
const info = g.infobox.length ? g.infobox : [
  ...(g.timing ? [{ label: "Thời gian", value: g.timing }] : []),
  ...(g.regions.length ? [{ label: "Vùng", value: g.regions.join(", ") }] : []),
  ...(g.applicable_to ? [{ label: "Áp dụng cho", value: g.applicable_to }] : []),
];
---
<Base title={g.title} description={g.description} path={path} ld={ld} image={image}>
  <article class="article" data-pagefind-body>
    <nav class="crumbs" aria-label="Đường dẫn" data-pagefind-ignore>
      <a href="/">Dòng Họ Việt</a> › <a href="/so-tay.html">Sổ tay văn hoá</a> › <a href={`/so-tay/danh-muc/${categoryUrl(g.category)}.html`}>{categoryName(g.category)}</a> › {shortName(entry)}
    </nav>
    <h1 data-pagefind-meta="title">{g.title}</h1>
    <p class="meta">Cập nhật {d}{g.minutes ? ` · khoảng ${g.minutes} phút đọc` : ""} · Dòng Họ Việt</p>
    <p class="lead" set:html={g.lead ?? g.description}></p>
    {hero && (
      <figure><img src={`/assets/le-hoi/${hero.file}`} alt={hero.alt} width={hero.w} height={hero.h} data-pagefind-meta="image[src]" /><figcaption set:html={`${hero.caption} · Ảnh: ${hero.credit}`}></figcaption></figure>
    )}
    {info.length > 0 && (
      <table class="infobox"><caption class="sr-only">Thông tin nhanh</caption>
        <tbody>{info.map((r) => (<tr><th scope="row">{r.label}</th><td set:html={r.value}></td></tr>))}</tbody>
      </table>
    )}
    <Content />
    {g.faq.length > 0 && (<>
      <h2>Câu hỏi thường gặp</h2>
      <div class="faq">
        {g.faq.map((f, i) => (<details open={i === 0}><summary>{f.q}<svg class="ico"><use href="#i-plus"></use></svg></summary><div class="ans">{f.a}</div></details>))}
      </div>
    </>)}
    {g.heritage && (<><h2>Phong tục và cội nguồn dòng họ</h2><p set:html={g.heritage}></p></>)}
    {g.tags.length > 0 && (
      <p class="tags" data-pagefind-ignore>
        Thẻ: {g.tags.map((t, i) => (<><a href={`/so-tay/the/${slugify(t)}.html`}>{t}</a>{i < g.tags.length - 1 ? " · " : ""}</>))}
      </p>
    )}
    <div data-pagefind-ignore><Cta campaign={entry.id} title="Giữ gìn cội nguồn của dòng họ bạn" /></div>
    {related.length > 0 && (
      <div data-pagefind-ignore>
        <h2>Bài liên quan</h2>
        <div class="related">{related.map((r) => (<a href={`/so-tay/${r!.id}.html`}>{shortName(r!)}</a>))}</div>
      </div>
    )}
    {g.sources.length > 0 && (<>
      <h2>Nguồn tham khảo</h2>
      <ul class="sources">
        {g.sources.map((s) => (<li>{s.url ? <a href={s.url} rel="noopener nofollow" target="_blank">{s.name}</a> : s.name}</li>))}
      </ul>
    </>)}
    <span data-pagefind-filter="danh mục" hidden>{categoryName(g.category)}</span>
    {g.tags.map((t) => <span data-pagefind-filter="thẻ" hidden>{t}</span>)}
  </article>
</Base>
