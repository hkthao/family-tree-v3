---
import "../generated/style.css";
import "../styles/blog.css";
import themeScript from "../generated/theme.html?raw";
import sprite from "../generated/sprite.html?raw";
import umami from "../generated/umami.html?raw";
import footer from "../generated/footer.html?raw";
import header from "../generated/header.html?raw";

interface Props {
  title: string;
  description: string;
  path: string;
  ld?: unknown;
  image?: string;
  noindex?: boolean;
}
const { title, description, path, ld, image, noindex } = Astro.props;
const SITE = "https://donghoviet.thaohk.com";
const APP = "https://giapha.thaohk.com";
const url = `${SITE}${path}`;
const og = image ? `${SITE}${image}` : `${SITE}/assets/og-banner.png`;
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#7A2230" />
    <link rel="icon" type="image/svg+xml" href="/assets/app-icon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/app-icon-180.png" />
    <Fragment set:html={umami} />
    <title>{title} | Dòng Họ Việt</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="article" />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="Dòng Họ Việt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content="vi_VN" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Noto+Serif:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <Fragment set:html={themeScript} />
    {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  </head>
  <body class="past-hero">
    <Fragment set:html={sprite} />
    <Fragment set:html={header} />
    <main><slot /></main>
    <Fragment set:html={footer} />
    <script is:inline>
      (function () {
        var root = document.documentElement, toggle = document.getElementById("themeToggle");
        var sprite = document.querySelector('svg[aria-hidden="true"]');
        if (sprite) sprite.insertAdjacentHTML("beforeend", '<symbol id="i-moon" viewBox="0 0 24 24"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></symbol><symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></symbol>');
        function syncIcon() { if (toggle) toggle.querySelector("use").setAttribute("href", root.classList.contains("dark") ? "#i-sun" : "#i-moon"); }
        syncIcon();
        if (toggle) toggle.addEventListener("click", function () {
          var dark = root.classList.toggle("dark"); root.style.colorScheme = dark ? "dark" : "light";
          try { localStorage.setItem("family-tree:theme", dark ? "dark" : "light"); } catch (e) {}
          var m = document.querySelector('meta[name="theme-color"]'); if (m) m.setAttribute("content", dark ? "#1A1612" : "#7A2230");
          syncIcon();
        });
        var btn = document.getElementById("menuBtn"), menu = document.getElementById("mobileMenu");
        if (btn && menu) {
          var setOpen = function (o) { menu.classList.toggle("open", o); btn.setAttribute("aria-expanded", o); btn.querySelector("use").setAttribute("href", o ? "#i-close" : "#i-menu"); };
          btn.addEventListener("click", function () { setOpen(!menu.classList.contains("open")); });
          Array.prototype.forEach.call(menu.querySelectorAll("a"), function (a) { a.addEventListener("click", function () { setOpen(false); }); });
        }
      })();
    </script>
    <button class="to-top" id="toTop" type="button" aria-label="Lên đầu trang" title="Lên đầu trang"><svg class="ico"><use href="#i-up"></use></svg></button>
    <script is:inline>
      (function () {
        var b = document.getElementById("toTop"); if (!b) return;
        function sync() { b.classList.toggle("show", window.scrollY > 600); }
        window.addEventListener("scroll", sync, { passive: true }); sync();
        b.addEventListener("click", function () {
          window.scrollTo({ top: 0, behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
        });
      })();
    </script>
    <script is:inline>document.getElementById("year") && (document.getElementById("year").textContent = new Date().getFullYear());</script>
  </body>
</html>
