# Template for ./scripts/setup-deploy-secrets.sh
# Copy to .env.deploy and fill in real values.
#
# DO NOT commit the filled-in file — .env.deploy is gitignored
# alongside .env.local.

# ─── Supabase Cloud ──────────────────────────────────────────────
# Personal access token: Supabase Dashboard → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The <ref> piece of https://<ref>.supabase.co
SUPABASE_PROJECT_REF=abcdefghijklmnop

# Database password — Project Settings → Database
SUPABASE_DB_PASSWORD=replace-with-real-db-password

# ─── Netlify ─────────────────────────────────────────────────────
# Personal access token: Netlify User Settings → Applications
NETLIFY_AUTH_TOKEN=nfp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Site API ID: Netlify Site Settings → Site information
NETLIFY_SITE_ID=00000000-0000-0000-0000-000000000000

# ─── Build-time env (baked into the SPA bundle) ──────────────────
VITE_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# ─── Optional: Sentry error monitoring ───────────────────────────
# DSN from Sentry Project Settings → Client Keys. Skipped silently
# when empty — SPA still runs without crash reporting.
VITE_SENTRY_DSN=

# ─── Web Push (VAPID) ────────────────────────────────────────────
# Public key compiled into SPA bundle. Generate via:
#   npx web-push generate-vapid-keys
# Private key + subject go to Supabase Edge Function secrets only:
#   npx supabase secrets set VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@x.com
VITE_VAPID_PUBLIC_KEY=

# ─── VPS deploy (deploy-vps.yml) ─────────────────────────────────
# Docker Hub PAT: hub.docker.com → Account Settings → Security
DOCKER_USERNAME=hkthao
DOCKER_TOKEN=dckr_pat_xxx

# Target VPS — IP/hostname + SSH credentials.
VPS_HOST=
VPS_USER=root
VPS_PASSWORD=
