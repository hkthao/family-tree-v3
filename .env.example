# Supabase local (chạy `npm run db:start` rồi `npm run db:status` để lấy anon key)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Service role key chỉ dùng trong Edge Function / script seed local — KHÔNG đặt ở frontend.
# SUPABASE_SERVICE_ROLE_KEY=

# Web Push — public VAPID key, dùng client để subscribe. An toàn để lộ.
# Sinh bằng `npx web-push generate-vapid-keys`. Private key đặt làm secret
# cho Edge Function notify-events, KHÔNG đặt ở đây.
VITE_VAPID_PUBLIC_KEY=

# Umami self-hosted analytics. Bỏ trống = analytics tắt hoàn toàn
# (không inject script, không network request). Setup: see
# deploy/umami/docker-compose.yml.
VITE_UMAMI_URL=
VITE_UMAMI_WEBSITE_ID=
