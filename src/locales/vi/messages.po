l border bg-card shadow-sm"> <div className="p-3 text-sm"> <p className="font-medium"> {lastSync ? t`Đồng bộ gần nhất: ${formatRelative(status!.lastSyncAt!) ?? "?"}` : t`Chưa đồng bộ lần nào`} </p> {lastSync && ( <p className="text-xs text-muted-foreground"> {lastSync.toLocaleString("vi-VN")} </p> )} </div> {/* Hành động của cả thẻ nằm ở chân thẻ — docs/design-language.md. */} <div className="flex justify-end gap-2 border-t p-3"> <Button size="sm" type="button" onClick={() => syncM.mutate()} disabled={syncM.isPending}> <IconRefresh className={`mr-1.5 h-4 w-4 ${syncM.isPending ? "animate-spin" : ""}`} /> {syncM.isPending ? t`Đang đồng bộ…` : t`Đồng bộ ngay`} </Button> </div> </section> {status?.lastError && ( <Alert variant="destructive"> <AlertDescription> {t`Lần đồng bộ gần nhất báo lỗi: ${status.lastError}`} </AlertDescription> </Alert> )} {!status?.lastError && staleDays > STALE_DAYS && ( <Alert variant="destructive"> <AlertDescription> {lastSync ? t`Đã ${Math.floor(staleDays)} ngày không đồng bộ được tập nào. Token Facebook có thể đã hết hạn — kiểm tra biến FB_PAGE_TOKEN.` : t`Chưa chạy đồng bộ lần nào. Kiểm tra FB_PAGE_ID / FB_PAGE_TOKEN và lịch cron.`} </AlertDescription> </Alert> )} <CollapsibleFilters activeCount={visibility ? 1 : 0} onReset={() => { setVisibility(""); paging.patchAndResetPage({}); }} title={t`Lọc tập`} search={(toggle) => ( <SearchInput label={t`Tìm tập`} value={search} onChange={(e) => { setSearch(e.target.value); paging.patchAndResetPage({}); }} placeholder={t`Tìm theo tiêu đề tập…`} rightSlot={toggle} /> )} > <div className="flex flex-col gap-3"> <Select value={visibility} onChange={(e) => { setVisibility(e.target.value as "" | "visible" | "hidden"); paging.patchAndResetPage({}); }} aria-label={t`Lọc theo hiển thị`} icon={<IconTag />} className="h-11 w-full text-base" > <option value="">{t`Cả hiện và ẩn`}</option> <option value="visible">{t`Đang hiện`}</option> <option value="hidden">{t`Đang ẩn`}</option> </Select> </div> </CollapsibleFilters> {episodesQ.isLoading && ( <div className="rounded-xl border bg-card p-4 shadow-sm"> <p className="text-muted-foreground">{t`Đang tải…`}</p> </div> )} {!episodesQ.isLoading && filtered.length === 0 && ( <EmptyState icon={<IconSearch className="h-10 w-10" />} title={episodes.length === 0 ? t`Chưa có tập nào trong kho` : t`Không có tập nào khớp`} description={ episodes.length === 0 ? t`Bấm "Đồng bộ ngay" để kéo về.` : t`Thử bỏ bớt bộ lọc hoặc từ khoá.` } /> )} {filtered.length > 0 && ( <ul className="divide-y overflow-hidden rounded-xl border bg-card shadow-sm"> {paging.paged.map((ep) => ( <EpisodeRowItem key={ep.id} episode={ep} onOpen={() => setPanel({ mode: "view", episode: ep })} /> ))} </ul> )} {filtered.length > 0 && ( <Pagination page={paging.page} totalPages={paging.totalPages} total={paging.total} pageSize={paging.pageSize} unit={t`tập`} onPageChange={paging.setPage} pageSizeOptions={LIST_PAGE_SIZE_OPTIONS} onPageSizeChange={paging.setPageSize} /> )} <SidePanel open={panel !== null} title={panel?.mode === "edit" ? t`Sửa tập` : t`Tập podcast`} subtitle={panel?.episode.title} onClose={() => setPanel(null)} guard={panel?.mode === "edit"} > {panel && ( <EpisodeForm key={`${panel.mode}-${panel.episode.id}`} episode={panel.episode} readOnly={panel.mode === "view"} onEdit={() => setPanel({ mode: "edit", episode: panel.episode })} onCancel={() => setPanel(panel.mode === "edit" ? { mode: "view", episode: panel.episode } : null) } onSaved={() => setPanel(null)} /> )} </SidePanel> </div> </AdminShell> ); } /** Trạng thái ngăn kéo: xem (chỉ đọc) hoặc sửa một tập. */ type EpisodePanel = { mode: "view" | "edit"; episode: PodcastEpisode } | null; function EpisodeRowItem({ episode, onOpen }: { episode: PodcastEpisode; onOpen: () => void }) { const duration = formatDuration(episode.duration_seconds); return ( <li className={episode.is_visible ? "" : "bg-muted/30"}> <button type="button" onClick={onOpen} className="flex w-full items-stretch gap-3 p-3 text-left transition-colors hover:bg-muted/40" > {/* Ảnh bìa ngay trong danh sách: admin cần NHÌN THẤY cái mà người dùng sẽ thấy, nhất là khi ảnh bìa lấy từ Facebook và URL có hạn dùng — hỏng ảnh thì phải phát hiện ở đây. */} {episode.thumbnail_url ? ( <img src={episode.thumbnail_url} alt="" loading="lazy" className="min-h-14 w-14 shrink-0 self-stretch rounded-lg border object-cover" /> ) : ( <IconTile icon={IconMicrophone} tone="violet" /> )} <div className="min-w-0 flex-1"> <p className="line-clamp-2 font-medium leading-snug">{episode.title}</p> <p className="mt-0.5 text-xs text-muted-foreground/80"> {[formatDateOnly(episode.published_at), duration].filter(Boolean).join(" · ")} </p> <div className="mt-2 flex flex-wrap justify-end gap-1.5"> {episode.title_edited && ( <Chip tone="warning" icon={<IconPencil />}> {t`Tiêu đề đã sửa tay`} </Chip> )} <Chip tone={episode.is_visible ? "success" : "neutral"} icon={episode.is_visible ? <IconCheck /> : <IconBellOff />} > {episode.is_visible ? t`Đang hiện` : t`Đang ẩn`} </Chip> </div> </div> </button> </li> ); } function EpisodeForm({ episode, readOnly, onEdit, onCancel, onSaved, }: { episode: PodcastEpisode; readOnly: boolean; onEdit: () => void; onCancel: () => void; onSaved: () => void; }) { const qc = useQueryClient(); const toast = useToast(); const [title, setTitle] = useState(episode.title); const [visible, setVisible] = useState(episode.is_visible); const changed = title.trim() !== episode.title || visible !== episode.is_visible; const saveM = useMutation({ mutationFn: () => updatePodcastEpisode(episode.id, { ...(title.trim() !== episode.title ? { title: title.trim() } : {}), ...(visible !== episode.is_visible ? { is_visible: visible } : {}), }), onSuccess: () => { qc.invalidateQueries({ queryKey: ["podcast-admin-episodes"] }); qc.invalidateQueries({ queryKey: ["podcast-episodes"] }); qc.invalidateQueries({ queryKey: ["podcast-latest"] }); toast.success(t`Đã cập nhật tập`); onSaved(); }, onError: (e) => toast.error(t`Không lưu được`, { description: (e as Error).message }), }); return ( <form className="space-y-3" onSubmit={(e) => { e.preventDefault(); if (changed && title.trim()) saveM.mutate(); }} > <ReadOnlyFieldset readOnly={readOnly}> <div className="space-y-1.5"> <Label htmlFor="ep-title" required> {t`Tiêu đề tập`} </Label> <Input id="ep-title" icon={<IconMicrophone />} value={title} onChange={(e) => setTitle(e.target.value)} /> </div> <div className="grid grid-cols-2 gap-3"> <div className="min-w-0 space-y-1.5"> <Label htmlFor="ep-date">{t`Ngày đăng`}</Label> <Input id="ep-date" icon={<IconCalendar />} value={formatDateOnly(episode.published_at) ?? ""} readOnly /> </div> <div className="min-w-0 space-y-1.5"> <Label htmlFor="ep-dur">{t`Thời lượng`}</Label> <Input id="ep-dur" icon={<IconClock />} value={formatDuration(episode.duration_seconds) ?? ""} readOnly /> </div> </div> <label className="flex items-start gap-3"> <input type="checkbox" checked={visible} onChange={(e) => setVisible(e.target.checked)} className="mt-1 h-4 w-4 accent-primary" /> <span> <span className="font-medium">{t`Hiện trên trang Podcast`}</span> <span className="block text-sm text-muted-foreground"> {t`Bỏ chọn để ẩn tập không phù hợp (không xoá khỏi kho).`} </span> </span> </label> </ReadOnlyFieldset> <a href={episode.permalink_url} target="_blank" rel="noreferrer" className="inline-block text-sm text-primary hover:underline" > {t`Mở trên Facebook →`} </a> <ViewEditActions readOnly={readOnly} onEdit={onEdit} onCancel={onCancel} saving={saveM.isPending} canSave={changed && !!title.trim()} /> </form> ); } /** * Kết nối Facebook. * * Admin dán App ID + App Secret + token ngắn lấy từ Graph API Explorer; * máy chủ đổi sang token dài rồi lưu ở dạng mã hoá. Token KHÔNG bao giờ * quay ngược ra trình duyệt, và App Secret không được lưu lại ở đâu — nó * chỉ cần cho đúng lần đổi đó. * * Vì sao cho cắm trong app thay vì để env: đổi token là việc sẽ phải làm * lại nhiều lần (đổi mật khẩu Facebook là token chết), mà mỗi lần lại * phải ssh vào máy chủ thì sớm muộn cũng có lần không ai làm. */ function FacebookConnection() { const qc = useQueryClient(); const toast = useToast(); const [appId, setAppId] = useState(""); const [appSecret, setAppSecret] = useState(""); const [userToken, setUserToken] = useState(""); const [pages, setPages] = useState<{ id: string; name: string }[]>([]); const [open, setOpen] = useState(false); const statusQ = useQuery({ queryKey: ["fb-credential-status"], queryFn: () => getFbCredentialStatus(), }); const active = statusQ.data?.find((c) => c.is_active); const connectM = useMutation({ mutationFn: (pageId?: string) => connectFacebookPage({ appId, appSecret, userToken, pageId }), onSuccess: (r) => { if (r.needPage) { setPages(r.pages ?? []); toast.success(t`Tìm thấy ${r.pages?.length ?? 0} Trang — chọn một Trang`); return; } toast.success(t`Đã nối Trang ${r.pageName ?? ""}`); // Xoá khỏi bộ nhớ trình duyệt ngay khi xong việc. setAppSecret(""); setUserToken(""); setPages([]); setOpen(false); qc.invalidateQueries({ queryKey: ["fb-credential-status"] }); }, onError: (e) => toast.error(t`Không nối được`, { description: (e as Error).message }), }); const checkM = useMutation({ mutationFn: () => checkFacebookConnection(), onSuccess: (r) => { toast.success(t`Token còn tốt — Trang ${r.pageName}`); qc.invalidateQueries({ queryKey: ["fb-credential-status"] }); }, onError: (e) => { toast.error(t`Token không dùng được`, { description: (e as Error).message, }); qc.invalidateQueries({ queryKey: ["fb-credential-status"] }); }, }); return ( <section className="space-y-3 rounded-xl border bg-card shadow-sm p-3"> <div className="flex flex-wrap items-start justify-between gap-3"> <div className="min-w-0 text-sm"> <p className="font-medium">{t`Kết nối Facebook`}</p> {active ? ( <> <p className="text-muted-foreground"> Trang <span className="text-foreground">{active.page_name}</span>{" "} · token {active.hint} ·{" "} {active.token_expires_at ? t`hết hạn ${formatDateOnly(active.token_expires_at) ?? "?"}` : t`không hết hạn`} </p> {active.last_check_at && ( <p className="text-xs text-muted-foreground"> Kiểm tra gần nhất: {formatRelative(active.last_check_at)} —{" "} {active.last_check_ok ? t`tốt` : t`hỏng (${active.last_check_error ?? "?"})`} </p> )} </> ) : ( <p className="text-muted-foreground"> {t`Chưa nối Trang nào. Đồng bộ sẽ không chạy cho tới khi nối.`} </p> )} </div> </div> {active && !active.last_check_ok && active.last_check_error && ( <Alert variant="destructive"> <AlertDescription>{active.last_check_error}</AlertDescription> </Alert> )} {open && ( <div className="space-y-3 border-t pt-3"> <p className="text-xs text-muted-foreground"> <Trans> Lấy ở <span className="font-mono">developers.facebook.com</span>: App ID và App Secret trong Cài đặt › Cơ bản; token người dùng sinh {t`ở Graph API Explorer với quyền`}{" "} <span className="font-mono">pages_show_list</span>,{" "} <span className="font-mono">pages_read_engagement</span>,{" "} <span className="font-mono">pages_read_user_content</span>. Token ngắn hạn cũng được — máy chủ sẽ tự đổi sang loại dài hạn. </Trans> </p> <div className="grid grid-cols-1 gap-2 sm:grid-cols-2"> <label className="block space-y-1"> <span className="text-sm font-medium">App ID</span> <Input value={appId} onChange={(e) => setAppId(e.target.value)} placeholder="1671135124582219" /> </label> <label className="block space-y-1"> <span className="text-sm font-medium">App Secret</span> <Input type="password" value={appSecret} onChange={(e) => setAppSecret(e.target.value)} placeholder={t`không được lưu lại`} /> </label> </div> <label className="block space-y-1"> <span className="text-sm font-medium">{t`Token người dùng`}</span> <Input type="password" value={userToken} onChange={(e) => setUserToken(e.target.value)} placeholder="EAA…" /> </label> {pages.length > 0 && ( <div className="space-y-2"> <p className="text-sm font-medium">{t`Chọn Trang để lấy podcast:`}</p> <ul className="space-y-1"> {pages.map((pg) => ( <li key={pg.id}> <Button size="sm" variant="outline" className="w-full justify-start" onClick={() => connectM.mutate(pg.id)} disabled={connectM.isPending} > {pg.name} </Button> </li> ))} </ul> </div> )} {pages.length === 0 && ( <Button size="sm" onClick={() => connectM.mutate(undefined)} disabled={ connectM.isPending || !appId || !appSecret || !userToken } > {connectM.isPending ? t`Đang nối…` : t`Đọc danh sách Trang`} </Button> )} </div> )} <div className="flex flex-wrap justify-end gap-2 border-t pt-3"> {active && ( <Button size="sm" variant="outline" onClick={() => checkM.mutate()} disabled={checkM.isPending} > {checkM.isPending ? t`Đang kiểm tra…` : t`Kiểm tra token`} </Button> )} <Button size="sm" variant={active ? "outline" : "default"} onClick={() => setOpen((v) => !v)}> {open ? t`Đóng` : active ? t`Nối lại` : t`Nối Trang`} </Button> </div> </section> ); } 
