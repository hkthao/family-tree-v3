confirm"> <Trans> Gõ đúng tên dòng họ <strong>“{wipeClan.name}”</strong> để xác nhận xoá {wipeClan.person_count} người: </Trans> </Label> <Input id="wipe-confirm" icon={<IconFlame />} value={confirmText} onChange={(e) => setConfirmText(e.target.value)} placeholder={wipeClan.name} autoComplete="off" /> </div> )} <Button size="sm" variant="destructive" disabled={!canWipe || wipeM.isPending} onClick={() => wipeM.mutate()} > <IconTrash className="h-4 w-4 mr-1.5" /> {wipeM.isPending ? t`Đang xoá…` : t`Xoá toàn bộ danh bạ`} </Button> </div> </section> ); } 
