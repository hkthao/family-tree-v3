e="h-full bg-primary transition-all" style={{ width: `${Math.round((prog.scraped / prog.total) * 100)}%`, }} /> </div> )} <p className="text-xs text-muted-foreground"> <Trans> Gia phả lớn có thể mất vài phút. Có thể tạm dừng rồi tiếp tục sau — tiến độ được lưu trên máy chủ. </Trans> </p> </div> )} {result && ( <Alert variant="success"> <AlertDescription> ✓ Đã nhập <strong>{result.counts.persons}</strong> người ·{" "} <strong>{result.counts.families}</strong> gia đình vào{" "} <Link to={`/clans/${result.clanId}`} className="text-primary underline" > {resultClanName ?? t`dòng họ`} </Link> . {(result.warnings.ambiguousMothers > 0 || result.warnings.missingGender > 0) && ( <span className="block mt-1 text-muted-foreground"> Cần rà lại: {result.warnings.ambiguousMothers} con mẹ chưa chắc (mặc định vợ cả) {result.warnings.missingGender > 0 && t`, ${result.warnings.missingGender} thiếu giới tính`} . {result.warnings.note} </span> )} </AlertDescription> </Alert> )} </div> {/* ── Danger: wipe directory ── */} <div className="space-y-3 rounded-lg border border-destructive/40 bg-destructive/5 p-4"> <h2 className="text-lg font-semibold text-destructive"> {t`Xoá toàn bộ danh bạ (nguy hiểm)`} </h2> <Alert variant="destructive"> <Trans> <AlertDescription> <strong>{t`Hành động không thể hoàn tác.`}</strong> Xoá vĩnh viễn{" "} <strong>{t`tất cả người và quan hệ gia đình`}</strong> trong dòng họ đã chọn — KHÔNG khôi phục được từ nhật ký. Dòng họ, thành viên và cài đặt vẫn giữ nguyên. Chỉ dùng khi muốn nhập lại từ đầu. </AlertDescription> </Trans> </Alert> <div className="space-y-1.5"> <Label htmlFor="wipe-clan">{t`Dòng họ cần xoá danh bạ`}</Label> <FilterableSelect id="wipe-clan" icon={<IconBuildings />} value={wipeClanId} onChange={(v) => { setWipeClanId(v); setConfirmText(""); }} options={clans.map((c) => ({ value: c.id, label: t`${c.name} (${c.person_count} người)`, }))} emptyLabel={t`— Chọn dòng họ —`} filterLabel={t`Tìm dòng họ`} /> </div> {wipeClan && ( <div className="space-y-1.5"> <Label htmlFor="wipe-confirm"> <Trans> Gõ đúng tên dòng họ <strong>“{wipeClan.name}”</strong> để xác nhận xoá {wipeClan.person_count} người: </Trans> </Label> <Input id="wipe-confirm" icon={<IconFlame />} value={confirmText} onChange={(e) => setConfirmText(e.target.value)} placeholder={wipeClan.name} autoComplete="off" /> </div> )} <Button size="sm" variant="destructive" disabled={!canWipe || wipeM.isPending} onClick={() => wipeM.mutate()} > <IconTrash className="h-4 w-4 mr-1.5" /> {wipeM.isPending ? t`Đang xoá…` : t`Xoá toàn bộ danh bạ`} </Button> </div> </section> ); } 
