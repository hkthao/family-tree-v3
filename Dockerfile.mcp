# Máy chủ MCP cho AI bên ngoài — xem docs/mcp-ket-noi-ai.md.
# Build từ GỐC repo (cần supabase/functions/_shared: cors + bản vendor xưng hô/âm lịch): docker build -f Dockerfile.mcp -t family-tree-v3-mcp .
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY mcp-server ./mcp-server
# Mã dựng sổ PDF của FE (src/lib/pdf, src/lib/queries…) được gộp vào bundle — xem mcp-server/build.mjs.
COPY src ./src
COPY supabase/functions/_shared ./supabase/functions/_shared
COPY supabase/functions/publish-so-tay ./supabase/functions/publish-so-tay
RUN node mcp-server/build.mjs

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3333
# Phần native/nặng không gộp vào bundle mà cài riêng theo ĐÚNG phiên bản trong package.json gốc:
# sharp (ảnh đại diện) và @react-pdf/renderer + react (xuất sổ gia phả PDF).
COPY package.json /tmp/root-package.json
RUN node -e "const p=require('/tmp/root-package.json');const v=(n)=>(p.dependencies?.[n]??p.devDependencies?.[n]).replace(/^[^0-9]*/,'');console.log(['sharp','@react-pdf/renderer','react'].map(n=>n+'@'+v(n)).join(' '))" > /tmp/pkgs.txt \
 && npm init -y >/dev/null && npm install --omit=dev --no-audit --no-fund $(cat /tmp/pkgs.txt) \
 && rm -rf /tmp/root-package.json /tmp/pkgs.txt /root/.npm
# Font, logo, ảnh minh hoạ, hình nền mờ của sổ PDF (bản sao của public/ — xem PDF_ASSET_DIR).
COPY public/fonts ./assets/fonts
COPY public/avatars ./assets/avatars
COPY public/icons/app-icon-192.png ./assets/icons/app-icon-192.png
COPY public/watermarks ./assets/watermarks
ENV PDF_ASSET_DIR=/app/assets
COPY --from=build /app/mcp-server/dist/server.mjs ./server.mjs
USER node
EXPOSE 3333
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:3333/healthz || exit 1
# Trần bộ nhớ V8: dựng sổ PDF phình RAM rất mạnh nếu để mặc định (đo thực tế: cùng một sổ 500 người dùng 1,3 GB
# khi không giới hạn nhưng ~0,7 GB khi giới hạn 450 MB mà không chậm hơn).
CMD ["node", "--max-old-space-size=600", "server.mjs"]
