# Máy chủ MCP cho AI bên ngoài — xem docs/mcp-ket-noi-ai.md.
# Build từ GỐC repo (cần supabase/functions/_shared: cors + bản vendor xưng hô/âm lịch): docker build -f Dockerfile.mcp -t family-tree-v3-mcp .
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY mcp-server ./mcp-server
COPY supabase/functions/_shared ./supabase/functions/_shared
RUN node mcp-server/build.mjs

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3333
COPY --from=build /app/mcp-server/dist/server.mjs ./server.mjs
USER node
EXPOSE 3333
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:3333/healthz || exit 1
CMD ["node", "server.mjs"]
