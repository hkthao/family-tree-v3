    "@radix-ui/react-slot": "^1.2.4",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/react": "^10.56.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/query-sync-storage-persister": "^5.100.14",
